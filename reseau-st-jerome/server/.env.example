# Copiez ce fichier en ".env" puis adaptez les valeurs. Ne publiez JAMAIS le fichier .env sur GitHub.

PORT=3000
NODE_ENV=development

# Connexion PostgreSQL (exemple local)
DATABASE_URL=postgres://postgres:motdepasse@localhost:5432/saintjerome
# Mettre "true" si l'hébergeur de la base exige SSL (cas fréquent des bases en ligne)
DATABASE_SSL=false

# Clé secrète longue et aléatoire (au moins 32 caractères). Pour en générer une :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez-moi-par-une-longue-valeur-aleatoire-de-48-octets

# Dossier des images envoyées
UPLOAD_DIR=./uploads

# E-mails : laissez SMTP_HOST vide en développement, les codes s'afficheront dans la console du serveur.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Réseau Saint Jérôme <no-reply@example.com>"
